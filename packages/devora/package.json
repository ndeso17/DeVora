{
  "name": "@devora/voice",
  "version": "0.1.0",
  "description": "DeVora — voice interaction layer for OpenCode (TUI plugin + core voice engine)",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build:plugin": "bun build src/plugin.tsx --target=bun --outfile=dist/plugin.js --external solid-js --external @opentui/solid --external @opentui/solid/components --external @opentui/solid/jsx-runtime --external @opentui/core --external @opentui/keymap --external @opencode-ai/plugin",
    "build": "bun run build:plugin && tsc --noEmit",
    "test": "bun test",
    "devora": "bun run bin/devora.ts"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.21",
    "@opentui/solid": "0.5.7",
    "@opencode-ai/plugin": "1.18.21",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
